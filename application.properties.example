# Copy to src/main/resources/application.properties and fill in your values.
spring.application.name=blog-api
spring.datasource.url=jdbc:mysql://localhost:3306/blogdb
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Generate with: openssl rand -base64 48  (must be at least 32 bytes)
app.jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_STRING
app.jwt.expiration=86400000
